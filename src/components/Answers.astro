---
import { t, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<section class="answers" id="faq" aria-labelledby="answers-title">
  <div class="wrap answersGrid">
    <div class="answersIntro">
      <p class="kicker">{s.answersLabel}</p>
      <h2 id="answers-title">{s.answersTitle}</h2>
    </div>
    <div class="answerList">
      {s.faqs.map((faq) => (
        <details class="answer">
          <summary>
            <span>{faq.q}</span>
            <span class="answerToggle" aria-hidden="true">+</span>
          </summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
