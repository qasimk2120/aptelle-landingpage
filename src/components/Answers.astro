---
import { t, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<section class="answers" aria-labelledby="answers-title">
  <div class="wrap">
    <p class="kicker">{s.answersLabel}</p>
    <h2 id="answers-title">{s.answersTitle}</h2>
    <div class="answerList">
      {s.faqs.map((faq, index) => (
        <details class="answer">
          <p class="index" aria-hidden="true">0{index + 1}</p>
          <summary>
            <span>{faq.q}</span>
            <span class="answerToggle" aria-hidden="true">+</span>
          </summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
