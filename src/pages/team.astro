---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const lang = "en" as const;

const team = [
  {
    name: "Muhammad Qasim",
    title: "Founder / CTO",
    bio: "Builds Aptelle end to end and everything else under CogniElevate. Started this because buying clothes online should not feel like a gamble.",
  },
  {
    name: "Hafsa Mustafa",
    title: "Cofounder",
    bio: "Shapes how Aptelle should feel to the people who actually shop. Keeps the product honest about the sizing problem it set out to fix.",
  },
];
---
<Base
  lang={lang}
  path="team"
  localized={false}
  title="Team | Aptelle"
  description="The two people building Aptelle, the fit intelligence layer for online fashion, and why we started it."
>
  <Header lang={lang} path="team" />
  <main id="main" class="team-page legal-page">
    <section class="wrap team">
      <p class="eyebrow">Meet the team</p>
      <h1>The people behind <span class="accent">your right size</span></h1>

      <div class="story">
        <p>Buying clothes online is a gamble. Every brand sizes differently, so an M in one place is an L in another, and you only find out after it lands at your door.</p>
        <p>So we are building the fit layer. Tell Aptelle the sizes you already own and it tells you your size in any brand before you buy, with a confidence score you can trust. Small team on purpose, building in the open. Here is who is behind it.</p>
      </div>

      <div class="teamgrid">
        {team.map((m) => (
          <article class="person">
            <div class="pbody">
              <h2 translate="no">{m.name}</h2>
              <p class="role">{m.title}</p>
              <p class="bio">{m.bio}</p>
            </div>
          </article>
        ))}
      </div>

      <p class="foot">Want in early? <a href="/">Join the waitlist</a> or reach us at <a href="mailto:hello@aptelle.com">hello@aptelle.com</a>.</p>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .team-page {
    padding-block: clamp(64px, 12vh, 140px) clamp(48px, 10vh, 120px);
  }
  .team {
    max-width: 1080px;
  }
  .eyebrow {
    color: var(--champagne);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .team-page h1 {
    max-width: none;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .team-page h1 .accent {
    color: var(--champagne);
    font-style: italic;
  }
  .story {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px clamp(32px, 5vw, 64px);
  }
  @media (max-width: 720px) {
    .story {
      grid-template-columns: 1fr;
      max-width: 66ch;
    }
  }
  .story p {
    color: var(--muted);
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    line-height: 1.65;
  }
  .teamgrid {
    margin-top: clamp(40px, 7vh, 72px);
    display: grid;
    gap: clamp(20px, 3vw, 30px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 620px) {
    .teamgrid { grid-template-columns: 1fr; }
  }
  .person {
    border-top: 1px solid var(--line);
  }
  .pbody {
    padding: clamp(22px, 2.6vw, 32px) 0 0;
  }
  .person h2 {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .role {
    margin-top: 4px;
    color: var(--champagne);
    font-weight: 600;
    font-size: 0.98rem;
  }
  .bio {
    margin-top: 14px;
    color: var(--muted);
    line-height: 1.6;
  }
  .foot {
    margin-top: clamp(40px, 7vh, 72px);
    color: var(--muted);
    font-size: 1.02rem;
  }
  .foot a {
    color: var(--champagne);
    font-weight: 600;
    text-decoration: none;
  }
  .foot a:hover {
    text-decoration: underline;
  }
</style>
